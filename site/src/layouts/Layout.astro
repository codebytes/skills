---
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const {
  title = "Codebytes Skills Catalog",
  description = "Portable, tested agent skills for GitHub Copilot, Codex, Claude Code, Cursor, Gemini CLI, and other Agent Skills compatible hosts.",
  wide = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const repo = "codebytes/skills";
const ogImage = new URL(`${base}images/og.svg`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        try {
          theme = localStorage.getItem("theme") || theme;
        } catch (error) {
          console.warn("Could not read the saved theme.", error);
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <ClientRouter />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #0d1117;
        --panel: #161b22;
        --border: #30363d;
        --fg: #e6edf3;
        --muted: #9198a1;
        --accent: #58a6ff;
        --accent-solid: #1f6feb;
        --focus: rgb(88 166 255 / 45%);
        --radius: 12px;
      }
      :root[data-theme="light"] {
        color-scheme: light;
        --bg: #fff;
        --panel: #f6f8fa;
        --border: #d0d7de;
        --fg: #1f2328;
        --muted: #59636e;
        --accent: #0969da;
        --accent-solid: #0969da;
        --focus: rgb(9 105 218 / 30%);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        color: var(--fg);
        font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        background: var(--bg);
      }
      a { color: var(--accent); }
      a:focus-visible, button:focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
      code {
        padding: 0.1em 0.4em;
        overflow-wrap: anywhere;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.9em;
        background: color-mix(in srgb, var(--accent) 12%, transparent);
        border-radius: 6px;
      }
      pre code { padding: 0; overflow-wrap: normal; font-size: inherit; background: none; border-radius: 0; }
      .skip-link {
        position: fixed;
        top: 0.5rem;
        left: 0.5rem;
        z-index: 100;
        padding: 0.55rem 0.8rem;
        color: #fff;
        background: var(--accent-solid);
        border-radius: 8px;
        transform: translateY(-150%);
      }
      .skip-link:focus { transform: translateY(0); }
      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.6rem clamp(1rem, 4vw, 2rem);
        background: color-mix(in srgb, var(--bg) 90%, transparent);
        border-bottom: 1px solid var(--border);
        backdrop-filter: blur(8px);
      }
      .brand { color: var(--fg); font-weight: 700; text-decoration: none; }
      .topnav { display: flex; gap: 1rem; }
      .topnav a { color: var(--muted); font-weight: 500; text-decoration: none; }
      .bar-actions { display: flex; align-items: center; gap: 0.4rem; margin-left: auto; }
      .icon-btn {
        display: inline-flex;
        width: 38px;
        height: 38px;
        align-items: center;
        justify-content: center;
        color: var(--fg);
        text-decoration: none;
        cursor: pointer;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 9px;
      }
      .icon-btn:hover { border-color: var(--accent); }
      .wrap { max-width: 760px; margin: 0 auto; padding: clamp(1.5rem, 5vw, 3.5rem) 1.25rem; }
      .wrap.wide { max-width: 1200px; }
      .card { padding: 1.25rem 1.4rem; margin: 1rem 0; background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); }
      .card h2 { margin: 0 0 0.5rem; font-size: 1.2rem; }
      .muted { color: var(--muted); }
      .btn {
        display: inline-block;
        padding: 0.55rem 1.05rem;
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        background: var(--accent-solid);
        border: 1px solid transparent;
        border-radius: 9px;
      }
      .codeblock { position: relative; }
      .copy-btn {
        position: absolute;
        top: 0.4rem;
        right: 0.4rem;
        padding: 0.3rem 0.55rem;
        color: var(--muted);
        font: 600 0.72rem/1 system-ui, sans-serif;
        cursor: pointer;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
      }
      .copy-btn:hover { color: var(--fg); border-color: var(--accent); }
      .copy-btn.copied { color: #fff; background: var(--accent-solid); border-color: var(--accent-solid); }
      @media (max-width: 620px) {
        .topbar { flex-wrap: wrap; gap: 0.5rem 0.9rem; }
        .topnav { order: 3; width: 100%; }
      }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { scroll-behavior: auto !important; transition-duration: 0.01ms !important; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="topbar">
      <a class="brand" href={base}>Codebytes Skills Catalog</a>
      <nav class="topnav" aria-label="Primary">
        <a href={base}>Home</a>
        <a href={`${base}catalog/`}>Skills</a>
        <a href={`${base}about/`}>About</a>
      </nav>
      <div class="bar-actions">
        <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle color theme" title="Toggle theme"></button>
        <a class="icon-btn" href={`https://github.com/${repo}`} target="_blank" rel="noopener noreferrer" aria-label="View source on GitHub" title="View source on GitHub">
          <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </div>
    </header>
    <main id="main-content" class:list={["wrap", { wide }]}><slot /></main>

    <script>
      const SUN = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"/></svg>';
      const MOON = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>';

      function currentTheme() {
        const fallback = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        try {
          return localStorage.getItem("theme") || fallback;
        } catch (error) {
          console.warn("Could not read the saved theme.", error);
          return fallback;
        }
      }

      function renderTheme() {
        document.documentElement.dataset.theme = currentTheme();
        const button = document.querySelector<HTMLButtonElement>("#theme-toggle");
        if (button) button.innerHTML = document.documentElement.dataset.theme === "dark" ? SUN : MOON;
      }

      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element) || !event.target.closest("#theme-toggle")) return;
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch (error) {
          console.warn("Could not save the theme.", error);
        }
        renderTheme();
      });
      document.addEventListener("astro:after-swap", renderTheme);
      document.addEventListener("astro:page-load", renderTheme);
      renderTheme();
    </script>

    <script>
      function enhanceCopyControls() {
        document.querySelectorAll<HTMLElement>(".card pre, .prose pre").forEach((pre) => {
          if (pre.dataset.copyReady) return;
          const code = pre.querySelector("code");
          if (!code) return;
          pre.dataset.copyReady = "true";

          const wrapper = document.createElement("div");
          wrapper.className = "codeblock";
          pre.parentNode?.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);
          pre.style.whiteSpace = "pre-wrap";
          pre.style.overflowWrap = "anywhere";
          pre.style.paddingRight = "4rem";

          const button = document.createElement("button");
          button.type = "button";
          button.className = "copy-btn";
          button.textContent = "Copy";
          button.setAttribute("aria-label", "Copy command to clipboard");
          button.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(code.textContent?.replace(/\n$/, "") ?? "");
              button.textContent = "Copied";
              button.classList.add("copied");
              window.setTimeout(() => {
                button.textContent = "Copy";
                button.classList.remove("copied");
              }, 1600);
            } catch (error) {
              console.error("Could not copy the command.", error);
              button.textContent = "Copy unavailable";
            }
          });
          wrapper.appendChild(button);
        });
      }

      document.addEventListener("astro:page-load", enhanceCopyControls);
    </script>
  </body>
</html>
